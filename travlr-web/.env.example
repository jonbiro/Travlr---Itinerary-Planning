# Required for Prisma and database-backed routes.
DATABASE_URL=

# Required for AI itinerary, packing-list, and chat routes.
OPENAI_API_KEY=
# Optional model override. The app defaults to gpt-5.6-luna.
OPENAI_MODEL=

# NextAuth and Google sign-in.
# Optional for local development. Defaults to demo mode when NODE_ENV is not
# production and Google auth is not configured. Production always requires a session.
TRAVLR_DEMO_MODE=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional integrations. Weather requires this key for live forecasts; when it
# is unset the app displays a configuration message instead of fake weather.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
OPENWEATHERMAP_API_KEY=
