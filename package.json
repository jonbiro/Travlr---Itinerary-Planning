{
  "name": "travlr",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm --prefix travlr-web run dev",
    "build": "npm --prefix travlr-web ci --include=dev && npm --prefix travlr-web run build",
    "start": "npm --prefix travlr-web run start",
    "lint": "npm --prefix travlr-web run lint",
    "test": "npm --prefix travlr-web test",
    "typecheck": "npm --prefix travlr-web run typecheck",
    "db:migrate": "npm --prefix travlr-web run db:migrate",
    "heroku-postbuild": "npm run build"
  },
  "description": "Travlr AI itinerary planning application",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonbiro/Travlr---Itinerary-Planning.git"
  },
  "bugs": {
    "url": "https://github.com/jonbiro/Travlr---Itinerary-Planning/issues"
  },
  "homepage": "https://github.com/jonbiro/Travlr---Itinerary-Planning#readme"
}
